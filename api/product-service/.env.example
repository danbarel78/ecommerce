# Copy to .env for local runs. Values are read with the PRODUCT_API_ prefix.

# --- Database ---
# Local/test default is in-memory SQLite. Real: point at Aurora (via RDS Proxy).
# PRODUCT_API_DATABASE_URL=postgresql+asyncpg://ecommerce_admin:<password>@<aurora-proxy-endpoint>:5432/ecommerce
PRODUCT_API_DATABASE_URL=sqlite+aiosqlite:///:memory:

# --- Auth (Cognito / OIDC) — REQUIRES REAL VALUES for a real deployment ---
# PRODUCT_API_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXX/.well-known/jwks.json
# PRODUCT_API_JWT_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXX
PRODUCT_API_JWT_AUDIENCE=ecommerce-api
PRODUCT_API_REQUIRED_WRITE_SCOPE=products:write

# --- Rate limiting ---
PRODUCT_API_RATE_LIMIT=100/minute

# --- App ---
PRODUCT_API_LOG_LEVEL=INFO
