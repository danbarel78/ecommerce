# Copy to dev.tfvars and fill with real values (dev.tfvars is gitignored).
# All entries below REQUIRE REAL VALUES for a real deployment.

region = "us-east-1"
azs    = ["us-east-1a", "us-east-1b", "us-east-1c"]
owner  = "platform-team"

# ACM certificate in the same region as the ALB.
acm_certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/REPLACE-ME"

# Restrict who can reach the EKS public API endpoint (office/VPN CIDRs).
eks_public_access_cidrs = ["203.0.113.0/24"]

# Budget alert recipients.
budget_notification_emails = ["finops@example.com"]
